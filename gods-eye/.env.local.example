# God's Eye — Frontend environment variables
# Copy this file to .env.local and fill in your values.
# Add the same variables in your Vercel project dashboard under:
#   Settings > Environment Variables

# ---------------------------------------------------------------------------
# Supabase (required for persistent moments + scalable Parquet storage)
# Get these from: https://app.supabase.com > Project > Settings > API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# ---------------------------------------------------------------------------
# If both vars above are left empty, the app falls back to:
#   • Parquet files served from the same Vercel deployment (/data/...)
#   • Saved moments stored in localStorage (browser-local, not shared)
# ---------------------------------------------------------------------------
